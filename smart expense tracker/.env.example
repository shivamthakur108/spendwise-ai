# SpendWise AI Environment Configuration
# Copy this file to .env and configure your environment settings:

# Backend Server Environment Variables (Server-Side ONLY)
# Never expose GEMINI_API_KEY to frontend code or commit to git repositories.
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3001
FRONTEND_URL=http://localhost:5173

# Optional Frontend Environment Variables (Build-Time ONLY)
# Set VITE_API_BASE_URL only if your deployed backend API is on a separate domain.
# VITE_API_BASE_URL=https://your-backend-service.onrender.com
